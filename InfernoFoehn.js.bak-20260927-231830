        var api = getShared("BossRegistry");
        if (!api) return;
        if (api !== lastRegistryApi || !api.get(BOSS_ID)) {
            api.register(bossDefinition);
            lastRegistryApi = api;
        } else {
            api.heartbeat(BOSS_ID);
        }
    } catch (e) {
        log.warn("InfernoFoehn 注册到 /call 框架失败：" + e);
    }
}

